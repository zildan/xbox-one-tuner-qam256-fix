diff --git a/src_orig/mn88472_priv.h b/src_patched/mn88472_priv.h
index 3375627..0cf84c0 100644
--- a/src_orig/mn88472_priv.h
+++ b/src_patched/mn88472_priv.h
@@ -13,6 +13,9 @@
 #include "mn88472.h"
 #include <linux/firmware.h>
 #include <linux/regmap.h>
+#include <linux/jiffies.h>
+#include <linux/moduleparam.h>
+#include <linux/version.h>
 
 #define MN88472_FIRMWARE "dvb-demod-mn88472-02.fw"
 
@@ -25,6 +28,9 @@ struct mn88472_dev {
 	unsigned int active:1;
 	unsigned int ts_mode:1;
 	unsigned int ts_clk:1;
+	bool has_locked_stats;
+	enum fe_status cached_status;
+	unsigned long last_stat_jiffies;
 };
 
 #endif
diff --git a/src_orig/mn88472.c b/src_patched/mn88472.c
index 73922fc..b4691ec 100644
--- a/src_orig/mn88472.c
+++ b/src_patched/mn88472.c
@@ -3,10 +3,31 @@
  * Panasonic MN88472 DVB-T/T2/C demodulator driver
  *
  * Copyright (C) 2013 Antti Palosaari <crope@iki.fi>
+ *
+ * High-Bitrate QAM-256 / DiB0700 I2C FIFO-Stall Avoidance Patch:
+ * Prevents synchronous USB EP0/I2C status polling from stalling the DiB0700
+ * 8051 microcontroller's TS slave FIFO on ~50.87 Mbps DVB-C transponders,
+ * configures VARIABLE_TS_CLOCK (0xe3), and loads complete DVB-C bandwidth
+ * and TS output timing registers.
  */
 
 #include "mn88472_priv.h"
 
+static int stat_poll_interval;
+module_param(stat_poll_interval, int, 0644);
+MODULE_PARM_DESC(stat_poll_interval,
+	"Minimum interval in seconds between I2C status/CNR polls once locked on DVB-C (0 = cache while locked to prevent DiB0700 USB I2C TS FIFO stalls; default: 0)");
+
+static int force_variable_ts_clock = 1;
+module_param(force_variable_ts_clock, int, 0644);
+MODULE_PARM_DESC(force_variable_ts_clock,
+	"Force VARIABLE_TS_CLOCK (0xe3 in reg 0xd9) for smoother TS FIFO pacing (default: 1)");
+
+static int dvbc_d6_val = 0x46;
+module_param(dvbc_d6_val, int, 0644);
+MODULE_PARM_DESC(dvbc_d6_val,
+	"Register 0xd6 TS output config for DVB-C (0x46 = high-bitrate/T2 timing, 0x48 = stock; default: 0x46)");
+
 static int mn88472_get_tune_settings(struct dvb_frontend *fe,
 				     struct dvb_frontend_tune_settings *s)
 {
@@ -28,6 +49,27 @@ static int mn88472_read_status(struct dvb_frontend *fe, enum fe_status *status)
 		goto err;
 	}
 
+	/*
+	 * On DiB0700 USB bridges (such as the Xbox One Digital TV Tuner),
+	 * every I2C read is a synchronous USB EP0 control request handled by
+	 * the single-threaded 8051 microcontroller. Performing 5 I2C transfers
+	 * (10 USB EP0 round-trips) every second during a 50.87 Mbps QAM-256
+	 * DVB-C stream stalls the DiB0700 TS FIFO just long enough to drop
+	 * 1 MPEG-TS packet per poll.
+	 *
+	 * Once locked with valid CNR & strength statistics acquired, return
+	 * the cached lock status without disturbing the I2C bus (unless
+	 * stat_poll_interval > 0 and the interval has elapsed).
+	 */
+	if (dev->has_locked_stats) {
+		if (stat_poll_interval <= 0 ||
+		    time_before(jiffies, dev->last_stat_jiffies +
+				msecs_to_jiffies(stat_poll_interval * 1000))) {
+			*status = dev->cached_status;
+			return 0;
+		}
+	}
+
 	switch (c->delivery_system) {
 	case SYS_DVBT:
 		ret = regmap_read(dev->regmap[0], 0x7f, &utmp);
@@ -190,6 +232,14 @@ static int mn88472_read_status(struct dvb_frontend *fe, enum fe_status *status)
 		c->block_count.stat[0].scale = FE_SCALE_NOT_AVAILABLE;
 	}
 
+	if ((*status & FE_HAS_LOCK) && c->cnr.stat[0].svalue > 0) {
+		dev->cached_status = *status;
+		dev->last_stat_jiffies = jiffies;
+		dev->has_locked_stats = true;
+	} else {
+		dev->has_locked_stats = false;
+	}
+
 	return 0;
 err:
 	dev_dbg(&client->dev, "failed=%d\n", ret);
@@ -218,6 +268,10 @@ static int mn88472_set_frontend(struct dvb_frontend *fe)
 		goto err;
 	}
 
+	/* Reset cached lock state on every tune request */
+	dev->has_locked_stats = false;
+	dev->cached_status = 0;
+
 	switch (c->delivery_system) {
 	case SYS_DVBT:
 		delivery_system_val = 0x02;
@@ -238,7 +292,7 @@ static int mn88472_set_frontend(struct dvb_frontend *fe)
 		reg_bank0_b4_val = 0x00;
 		reg_bank0_cd_val = 0x17;
 		reg_bank0_d4_val = 0x09;
-		reg_bank0_d6_val = 0x48;
+		reg_bank0_d6_val = (u8)dvbc_d6_val;
 		break;
 	default:
 		ret = -EINVAL;
@@ -271,7 +325,7 @@ static int mn88472_set_frontend(struct dvb_frontend *fe)
 		}
 		break;
 	case SYS_DVBC_ANNEX_A:
-		bandwidth_vals_ptr = NULL;
+		bandwidth_vals_ptr = "\x8f\x80\x00\x08\xee\x08\xee";
 		bandwidth_val = 0x00;
 		break;
 	default:
@@ -375,11 +429,27 @@ static int mn88472_set_frontend(struct dvb_frontend *fe)
 			goto err;
 		break;
 	case SYS_DVBC_ANNEX_A:
+		ret = regmap_write(dev->regmap[0], 0x46, 0x00);
+		if (ret)
+			goto err;
+		ret = regmap_write(dev->regmap[0], 0xae, 0x00);
+		if (ret)
+			goto err;
+		ret = regmap_write(dev->regmap[0], 0xb0, 0x00);
+		if (ret)
+			goto err;
 		break;
 	default:
 		break;
 	}
 
+	/* Ensure TS clock mode is applied */
+	utmp = (force_variable_ts_clock || dev->ts_clk == VARIABLE_TS_CLOCK) ?
+	       0xe3 : 0xe1;
+	ret = regmap_write(dev->regmap[0], 0xd9, utmp);
+	if (ret)
+		goto err;
+
 	/* Reset FSM */
 	ret = regmap_write(dev->regmap[2], 0xf8, 0x9f);
 	if (ret)
@@ -402,6 +472,9 @@ static int mn88472_init(struct dvb_frontend *fe)
 
 	dev_dbg(&client->dev, "\n");
 
+	dev->has_locked_stats = false;
+	dev->cached_status = 0;
+
 	/* Power up */
 	ret = regmap_write(dev->regmap[2], 0x05, 0x00);
 	if (ret)
@@ -476,17 +549,11 @@ warm:
 	if (ret)
 		goto err;
 
-	switch (dev->ts_clk) {
-	case VARIABLE_TS_CLOCK:
+	if (force_variable_ts_clock || dev->ts_clk == VARIABLE_TS_CLOCK)
 		utmp = 0xe3;
-		break;
-	case FIXED_TS_CLOCK:
+	else
 		utmp = 0xe1;
-		break;
-	default:
-		ret = -EINVAL;
-		goto err;
-	}
+
 	ret = regmap_write(dev->regmap[0], 0xd9, utmp);
 	if (ret)
 		goto err;
@@ -509,6 +576,9 @@ static int mn88472_sleep(struct dvb_frontend *fe)
 
 	dev_dbg(&client->dev, "\n");
 
+	dev->has_locked_stats = false;
+	dev->cached_status = 0;
+
 	/* Power down */
 	ret = regmap_write(dev->regmap[2], 0x0c, 0x30);
 	if (ret)
@@ -572,8 +642,12 @@ static struct dvb_frontend *mn88472_get_dvb_frontend(struct i2c_client *client)
 	return &dev->fe;
 }
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 3, 0)
+static int mn88472_probe(struct i2c_client *client)
+#else
 static int mn88472_probe(struct i2c_client *client,
 			 const struct i2c_device_id *id)
+#endif
 {
 	struct mn88472_config *pdata = client->dev.platform_data;
 	struct mn88472_dev *dev;
@@ -671,7 +745,8 @@ static int mn88472_probe(struct i2c_client *client,
 	/* Setup callbacks */
 	pdata->get_dvb_frontend = mn88472_get_dvb_frontend;
 
-	dev_info(&client->dev, "Panasonic MN88472 successfully identified\n");
+	dev_info(&client->dev,
+		 "Panasonic MN88472 identified (QAM-256 high-bitrate patch active)\n");
 
 	return 0;
 err_regmap_2_regmap_exit:
@@ -691,6 +766,24 @@ err:
 	return ret;
 }
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+static void mn88472_remove(struct i2c_client *client)
+{
+	struct mn88472_dev *dev = i2c_get_clientdata(client);
+
+	dev_dbg(&client->dev, "\n");
+
+	regmap_exit(dev->regmap[2]);
+	i2c_unregister_device(dev->client[2]);
+
+	regmap_exit(dev->regmap[1]);
+	i2c_unregister_device(dev->client[1]);
+
+	regmap_exit(dev->regmap[0]);
+
+	kfree(dev);
+}
+#else
 static int mn88472_remove(struct i2c_client *client)
 {
 	struct mn88472_dev *dev = i2c_get_clientdata(client);
@@ -709,6 +802,7 @@ static int mn88472_remove(struct i2c_client *client)
 
 	return 0;
 }
+#endif
 
 static const struct i2c_device_id mn88472_id_table[] = {
 	{"mn88472", 0},
@@ -729,6 +823,6 @@ static struct i2c_driver mn88472_driver = {
 module_i2c_driver(mn88472_driver);
 
 MODULE_AUTHOR("Antti Palosaari <crope@iki.fi>");
-MODULE_DESCRIPTION("Panasonic MN88472 DVB-T/T2/C demodulator driver");
+MODULE_DESCRIPTION("Panasonic MN88472 DVB-T/T2/C demodulator driver (QAM-256 high-bitrate fixed)");
 MODULE_LICENSE("GPL");
 MODULE_FIRMWARE(MN88472_FIRMWARE);
