From 621d1c1baddc97c1458dcf23c74720abbd6db423 Mon Sep 17 00:00:00 2001
From: zildan <zildan@users.noreply.github.com>
Date: Mon, 2 Nov 2026 01:19:52 +0200
Subject: [PATCH] media: mn88472 / dib0700: fix Xbox One Tuner packet drops on
 high-bitrate DVB-C QAM-256

---
 drivers/media/dvb-frontends/mn88472.c       | 72 +++++++++++++++++----
 drivers/media/dvb-frontends/mn88472_priv.h  |  5 ++
 drivers/media/usb/dvb-usb/dib0700_devices.c |  2 +-
 3 files changed, 67 insertions(+), 12 deletions(-)

diff --git a/drivers/media/dvb-frontends/mn88472.c b/drivers/media/dvb-frontends/mn88472.c
index 73d1e52de..97df16ec7 100644
--- a/drivers/media/dvb-frontends/mn88472.c
+++ b/drivers/media/dvb-frontends/mn88472.c
@@ -7,6 +7,21 @@
 
 #include "mn88472_priv.h"
 
+static int stat_poll_interval;
+module_param(stat_poll_interval, int, 0644);
+MODULE_PARM_DESC(stat_poll_interval,
+	"Minimum interval in seconds between I2C status/CNR polls once locked (0 = cache while locked to prevent USB I2C TS FIFO stalls; default: 0)");
+
+static int force_variable_ts_clock = 1;
+module_param(force_variable_ts_clock, int, 0644);
+MODULE_PARM_DESC(force_variable_ts_clock,
+	"Force VARIABLE_TS_CLOCK (0xe3 in reg 0xd9) for smoother TS FIFO pacing (default: 1)");
+
+static int dvbc_d6_val = 0x46;
+module_param(dvbc_d6_val, int, 0644);
+MODULE_PARM_DESC(dvbc_d6_val,
+	"Register 0xd6 TS output config for DVB-C (0x46 = high-bitrate timing, 0x48 = stock; default: 0x46)");
+
 static int mn88472_get_tune_settings(struct dvb_frontend *fe,
 				     struct dvb_frontend_tune_settings *s)
 {
@@ -28,6 +43,15 @@ static int mn88472_read_status(struct dvb_frontend *fe, enum fe_status *status)
 		goto err;
 	}
 
+	if (dev->has_locked_stats) {
+		if (stat_poll_interval <= 0 ||
+		    time_before(jiffies, dev->last_stat_jiffies +
+				msecs_to_jiffies(stat_poll_interval * 1000))) {
+			*status = dev->cached_status;
+			return 0;
+		}
+	}
+
 	switch (c->delivery_system) {
 	case SYS_DVBT:
 		ret = regmap_read(dev->regmap[0], 0x7f, &utmp);
@@ -190,6 +214,14 @@ static int mn88472_read_status(struct dvb_frontend *fe, enum fe_status *status)
 		c->block_count.stat[0].scale = FE_SCALE_NOT_AVAILABLE;
 	}
 
+	if ((*status & FE_HAS_LOCK) && c->cnr.stat[0].svalue > 0) {
+		dev->cached_status = *status;
+		dev->last_stat_jiffies = jiffies;
+		dev->has_locked_stats = true;
+	} else {
+		dev->has_locked_stats = false;
+	}
+
 	return 0;
 err:
 	dev_dbg(&client->dev, "failed=%d\n", ret);
@@ -218,6 +250,9 @@ static int mn88472_set_frontend(struct dvb_frontend *fe)
 		goto err;
 	}
 
+	dev->has_locked_stats = false;
+	dev->cached_status = 0;
+
 	switch (c->delivery_system) {
 	case SYS_DVBT:
 		delivery_system_val = 0x02;
@@ -238,7 +273,7 @@ static int mn88472_set_frontend(struct dvb_frontend *fe)
 		reg_bank0_b4_val = 0x00;
 		reg_bank0_cd_val = 0x17;
 		reg_bank0_d4_val = 0x09;
-		reg_bank0_d6_val = 0x48;
+		reg_bank0_d6_val = (u8)dvbc_d6_val;
 		break;
 	default:
 		ret = -EINVAL;
@@ -271,7 +306,7 @@ static int mn88472_set_frontend(struct dvb_frontend *fe)
 		}
 		break;
 	case SYS_DVBC_ANNEX_A:
-		bandwidth_vals_ptr = NULL;
+		bandwidth_vals_ptr = "\x8f\x80\x00\x08\xee\x08\xee";
 		bandwidth_val = 0x00;
 		break;
 	default:
@@ -375,11 +410,26 @@ static int mn88472_set_frontend(struct dvb_frontend *fe)
 			goto err;
 		break;
 	case SYS_DVBC_ANNEX_A:
+		ret = regmap_write(dev->regmap[0], 0x46, 0x00);
+		if (ret)
+			goto err;
+		ret = regmap_write(dev->regmap[0], 0xae, 0x00);
+		if (ret)
+			goto err;
+		ret = regmap_write(dev->regmap[0], 0xb0, 0x00);
+		if (ret)
+			goto err;
 		break;
 	default:
 		break;
 	}
 
+	utmp = (force_variable_ts_clock || dev->ts_clk == VARIABLE_TS_CLOCK) ?
+	       0xe3 : 0xe1;
+	ret = regmap_write(dev->regmap[0], 0xd9, utmp);
+	if (ret)
+		goto err;
+
 	/* Reset FSM */
 	ret = regmap_write(dev->regmap[2], 0xf8, 0x9f);
 	if (ret)
@@ -402,6 +452,9 @@ static int mn88472_init(struct dvb_frontend *fe)
 
 	dev_dbg(&client->dev, "\n");
 
+	dev->has_locked_stats = false;
+	dev->cached_status = 0;
+
 	/* Power up */
 	ret = regmap_write(dev->regmap[2], 0x05, 0x00);
 	if (ret)
@@ -476,17 +529,11 @@ static int mn88472_init(struct dvb_frontend *fe)
 	if (ret)
 		goto err;
 
-	switch (dev->ts_clk) {
-	case VARIABLE_TS_CLOCK:
+	if (force_variable_ts_clock || dev->ts_clk == VARIABLE_TS_CLOCK)
 		utmp = 0xe3;
-		break;
-	case FIXED_TS_CLOCK:
+	else
 		utmp = 0xe1;
-		break;
-	default:
-		ret = -EINVAL;
-		goto err;
-	}
+
 	ret = regmap_write(dev->regmap[0], 0xd9, utmp);
 	if (ret)
 		goto err;
@@ -509,6 +556,9 @@ static int mn88472_sleep(struct dvb_frontend *fe)
 
 	dev_dbg(&client->dev, "\n");
 
+	dev->has_locked_stats = false;
+	dev->cached_status = 0;
+
 	/* Power down */
 	ret = regmap_write(dev->regmap[2], 0x0c, 0x30);
 	if (ret)
diff --git a/drivers/media/dvb-frontends/mn88472_priv.h b/drivers/media/dvb-frontends/mn88472_priv.h
index 337562723..6c3769110 100644
--- a/drivers/media/dvb-frontends/mn88472_priv.h
+++ b/drivers/media/dvb-frontends/mn88472_priv.h
@@ -13,6 +13,8 @@
 #include "mn88472.h"
 #include <linux/firmware.h>
 #include <linux/regmap.h>
+#include <linux/jiffies.h>
+#include <linux/moduleparam.h>
 
 #define MN88472_FIRMWARE "dvb-demod-mn88472-02.fw"
 
@@ -25,6 +27,9 @@ struct mn88472_dev {
 	unsigned int active:1;
 	unsigned int ts_mode:1;
 	unsigned int ts_clk:1;
+	bool has_locked_stats;
+	enum fe_status cached_status;
+	unsigned long last_stat_jiffies;
 };
 
 #endif
diff --git a/drivers/media/usb/dvb-usb/dib0700_devices.c b/drivers/media/usb/dvb-usb/dib0700_devices.c
index 3af594134..675a0d37f 100644
--- a/drivers/media/usb/dvb-usb/dib0700_devices.c
+++ b/drivers/media/usb/dvb-usb/dib0700_devices.c
@@ -3754,7 +3754,7 @@ static int xbox_one_attach(struct dvb_usb_adapter *adap)
 	mn88472_config.i2c_wr_max = 22;
 	mn88472_config.xtal = 20500000;
 	mn88472_config.ts_mode = PARALLEL_TS_MODE;
-	mn88472_config.ts_clock = FIXED_TS_CLOCK;
+	mn88472_config.ts_clock = VARIABLE_TS_CLOCK;
 	memset(&info, 0, sizeof(struct i2c_board_info));
 	strscpy(info.type, "mn88472", I2C_NAME_SIZE);
 	info.addr = 0x18;
-- 
2.54.0.windows.1

